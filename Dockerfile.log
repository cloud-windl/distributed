FROM golang:1.25 AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o log-service ./cmd/logservice

FROM alpine:3.20

WORKDIR /app

COPY --from=builder /app/log-service /app/log-service

EXPOSE 4000

CMD ["/app/log-service"]